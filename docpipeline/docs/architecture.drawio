          <mxGeometry x="-0.2" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#D6B656;endArrow=block;" edge="1" parent="1" source="fbatch" target="fdoc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5l" value="5  fan out per file" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e5">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#D6B656;endArrow=block;" edge="1" parent="1" source="fdoc" target="fact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6l" value="6  fan out per page" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e6">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;endArrow=block;startArrow=block;" edge="1" parent="1" source="fmi" target="sdur">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7l" value="Durable state:&#10;queues + tables + blobs" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e7">
          <mxGeometry x="0.1" relative="1" as="geometry" />
