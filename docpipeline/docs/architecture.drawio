        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#D79B00;endArrow=block;" edge="1" parent="1" source="fact" target="fvnet">
          <mxGeometry relative="1" as="geometry" />
